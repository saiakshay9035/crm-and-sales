# AI Lead Acquisition Platform Environment Variables Example

# Application & Security
DASHBOARD_AUTH_TOKEN=your_secure_bearer_token_here
PORT=5050

# Primary Email Provider (Resend API)
RESEND_API_KEY=re_123456789_example

# Secondary Email Provider (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# LLM Providers (Ollama / Groq / OpenAI)
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=gsk_example
OPENAI_API_KEY=sk-proj-example

# Database Configuration
DB_PATH=leads.db
NEON_DATABASE_URL=postgresql://user:pass@ep-example.neon.tech/neondb
